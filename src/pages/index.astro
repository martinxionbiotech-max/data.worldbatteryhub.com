---
import batteries from '../data/batteries.json';

const SITE = 'https://data.worldbatteryhub.com';
const items = batteries.batteries;

const datasetJsonLd = {
  '@type': 'Dataset',
  name: 'Battery Group Reference Data',
  description: 'Typical capacity, CCA and technology by battery group size — H4-H9, L1-L6, JIS N-series and BCI groups.',
  url: `${SITE}/`,
  dateModified: '2026-09-14',
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Battery Group Reference Data | World Battery Hub</title>
    <meta name="description" content="Typical capacity, CCA and technology by battery group size — H4-H9, L1-L6, JIS N-series and BCI groups. Cross-verified reference data." />
    <link rel="canonical" href={`${SITE}/`} />
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; color: #1e293b; line-height: 1.6; }
      .container { max-width: 900px; margin: 0 auto; padding: 20px; }
      h1 { color: #0f1f3d; }
      table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
      th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #e5e9f0; }
      th { color: #0f1f3d; }
      .muted { color: #64748b; font-size: 0.85rem; }
    </style>
    <script type="application/ld+json" set:html={JSON.stringify(datasetJsonLd)} />
  </head>
  <body>
    <div class="container">
      <h1>Battery Group Reference Data</h1>
      <p>Typical capacity, cold cranking amps (CCA) and technology by battery group size. Values are cross-verified ranges, not a substitute for a specific battery&rsquo;s datasheet.</p>
      <p class="muted">⚠️ CCA basis matters — a JIS number (tested at −15°C) reads higher than an EN/SAE number (tested at −18°C) for the same battery. Compare only within one standard.</p>

      <table>
        <thead>
          <tr>
            <th>Group</th>
            <th>Alias</th>
            <th>Standard</th>
            <th>Voltage</th>
            <th>Capacity (Ah)</th>
            <th>CCA</th>
            <th>CCA basis</th>
            <th>Technology</th>
          </tr>
        </thead>
        <tbody>
          {items.map((b) => (
            <tr>
              <td><strong>{b.group}</strong></td>
              <td>{b.alias}</td>
              <td>{b.standard}</td>
              <td>{b.voltage}V</td>
              <td>{b.capacity_ah}</td>
              <td>{b.cca} A</td>
              <td>{b.cca_basis}</td>
              <td>{b.technology}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="muted">Source: cross-verified from manufacturer datasheets (Varta, Bosch, Yuasa, Century, Exide, Dingwei/Chengguang) and BCI group-size reference. Last verified: 2026-09-14.</p>
      <p class="muted">Return to <a href="https://worldbatteryhub.com">World Battery Hub</a>.</p>
    </div>
  </body>
</html>
