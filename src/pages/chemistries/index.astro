---
import chemistries from '../../data/chemistries.json';

const SITE = 'https://data.worldbatteryhub.com';
const items = chemistries.chemistries;

const datasetJsonLd = {
  '@type': 'Dataset',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  '@id': `${SITE}/#chemistries`,
  name: 'Lithium Cell Chemistry Reference Data',
  description: 'Reference data for lithium cell chemistries — LFP, NMC, NCA, LTO and LMFP, each with nominal voltage, cell-level energy density, cycle life and temperature window as typical ranges with sources.',
  url: `${SITE}/chemistries/`,
  variableMeasured: ['Nominal voltage', 'Energy density', 'Cycle life', 'Temperature window', 'Thermal stability'],
  dateModified: '2026-09-18',
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
