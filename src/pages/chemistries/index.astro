      th, td { text-align: left; padding: 8px 9px; border-bottom: 1px solid #e5e9f0; vertical-align: top; }
      th { color: #0f1f3d; }
    </style>
    <script type="application/ld+json" set:html={JSON.stringify(datasetJsonLd)} />
  
    <script type="application/ld+json" set:html={"{\"@context\": \"https://schema.org\", \"@type\": \"WebPage\", \"@id\": \"https://data.worldbatteryhub.com/chemistries/\", \"url\": \"https://data.worldbatteryhub.com/chemistries/\", \"name\": \"Lithium Cell Chemistries\", \"publisher\": {\"@id\": \"https://worldbatteryhub.com/#organization\"}, \"isPartOf\": {\"@id\": \"https://data.worldbatteryhub.com/\"}}"} />
    <script type="application/ld+json" set:html={"{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Battery Data\", \"item\": \"https://data.worldbatteryhub.com/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Chemistries\", \"item\": \"https://data.worldbatteryhub.com/chemistries/\"}]}"} />
  <script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Which chemistry has the longest cycle life?", "acceptedAnswer": {"@type": "Answer", "text": "LFP generally offers the longest cycle life among common lithium chemistries, followed by LTO in high-power applications and NMC/NCA in energy-focused designs. The exact count depends on depth of discharge, temperature and end-of-life criterion."}}, {"@type": "Question", "name": "Why do the same chemistry values differ between sources?", "acceptedAnswer": {"@type": "Answer", "text": "Cell design, electrode formulation, test temperature and the definition of end of life all change the result. The data site reports ranges and labels the evidence so that a single number is not mistaken for a universal specification."}}]}</script>
